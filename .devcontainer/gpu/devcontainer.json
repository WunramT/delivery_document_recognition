{
  "name": "docval (GPU, NVIDIA)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../..",
    "args": { "TORCH_INDEX": "https://download.pytorch.org/whl/cu126", "WITH_REFERENCE": "1" }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace",
  "mounts": [
    "source=${localWorkspaceFolder}/labels,target=/data,type=bind,readonly",
    "source=docval-models,target=/models,type=volume"
  ],
  "runArgs": ["--gpus", "all", "--shm-size=8g"],
  "postCreateCommand": "make fetch-models",
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}
